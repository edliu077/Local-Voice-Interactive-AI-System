# Configuration blueprint for Demo Stable v0.9. Copy it to a private `.env`
# and replace the placeholders with local paths. Never commit `.env`.

# Project and writable data roots
LVIAI_PROJECT_ROOT=D:\Path\To\LocalVoiceInteractiveAI
LVIAI_MODEL_ROOT=D:\Path\To\LocalVoiceInteractiveAI\models
LVIAI_RUNTIME_ROOT=D:\Path\To\LocalVoiceInteractiveAI\runtime

# Local model and executable paths
LVIAI_LLAMA_SERVER=D:\Path\To\LocalVoiceInteractiveAI\tools\llama.cpp\llama-server.exe
LVIAI_LLM_MODEL=D:\Path\To\LocalVoiceInteractiveAI\models\llm\qwen3-1.7b-q4_k_m\Qwen3-1.7B-Q4_K_M.gguf
LVIAI_STT_MODEL_ROOT=D:\Path\To\LocalVoiceInteractiveAI\models\faster-whisper
LVIAI_TTS_MODEL_ROOT=D:\Path\To\LocalVoiceInteractiveAI\models\qwen3-tts\0.6b-base
LVIAI_VAD_MODEL_ROOT=D:\Path\To\LocalVoiceInteractiveAI\models\silero-vad
LVIAI_STT_WARMUP_WAV=D:\Path\To\LocalVoiceInteractiveAI\assets\stt\warmup-16khz-mono.wav

# Isolated Python environments
LVIAI_ORCHESTRATOR_PYTHON=D:\Path\To\LocalVoiceInteractiveAI\backend\orchestrator\.venv\Scripts\python.exe
LVIAI_STT_PYTHON=D:\Path\To\LocalVoiceInteractiveAI\backend\stt\.venv\Scripts\python.exe
LVIAI_TTS_PYTHON=D:\Path\To\LocalVoiceInteractiveAI\backend\tts\.venv\Scripts\python.exe
LVIAI_NODE_EXE=C:\Program Files\nodejs\node.exe

# Private voice-clone inputs. Never commit the referenced files.
LVIAI_TTS_REFERENCE_AUDIO=D:\Private\VoiceReference\reference-short.wav
LVIAI_TTS_REFERENCE_TEXT=D:\Private\VoiceReference\reference-short.txt

# Loopback-only service configuration
LVIAI_FRONTEND_HOST=127.0.0.1
LVIAI_FRONTEND_PORT=3000
LVIAI_LLM_HOST=127.0.0.1
LVIAI_LLM_PORT=8080
LVIAI_TTS_HOST=127.0.0.1
LVIAI_TTS_PORT=8765
LVIAI_STT_HOST=127.0.0.1
LVIAI_STT_PORT=8766
LVIAI_WS_HOST=127.0.0.1
LVIAI_WS_PORT=8767
LVIAI_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LVIAI_PLAYBACK_MODE=browser

# Browser URLs for locally supplied, redistribution-authorized Live2D assets
NEXT_PUBLIC_LVIAI_LIVE2D_CORE_URL=/live2d/runtime/live2dcubismcore.min.js
NEXT_PUBLIC_LVIAI_LIVE2D_MODEL_URL=/live2d/model/model3.json
